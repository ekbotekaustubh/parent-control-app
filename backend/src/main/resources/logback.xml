<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Never log request/response bodies at INFO or above: signup/login carry plaintext
        passwords, and pairing/token endpoints carry secrets (codes, claim tickets, refresh
        tokens). CallLogging.kt only logs method/path/status/duration, never bodies.
    -->
    <logger name="io.ktor" level="INFO"/>
    <logger name="Exposed" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
