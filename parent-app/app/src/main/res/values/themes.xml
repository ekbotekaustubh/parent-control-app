<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Minimal pre-Compose window theme: controls the system splash/window background
         color only before MainActivity's Compose content (ui/theme/Theme.kt) takes over.
         All real theming (palette, typography) lives in Compose, not here. -->
    <style name="Theme.FamilyGuardParent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/white</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
