<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for all Retrofit/OkHttp calls to the backend (auth, children, pairing,
         rules, dashboard). This app never talks to the child device directly — everything
         goes through the backend (docs/architecture.md's "no peer-to-peer" design). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app check connectivity before/instead of firing a network call (e.g. to
         show an offline-aware error state rather than a raw timeout), and to decide when
         WorkManager's periodic DashboardRefreshWorker should skip a cycle. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ (API 33) requires this runtime permission before any notification can
         be posted. Used only for local "device went offline" / "sync issue" notifications
         raised by DashboardRefreshWorker (work/DashboardRefreshWorker.kt) — no marketing or
         remote push in this slice (see docs/roadmap.md's Notifications section for the
         planned FCM upgrade). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Deliberately NOT requested: CAMERA. This app only generates pairing QR codes
         (zxing MultiFormatWriter, encode-only); scanning happens on the child device. -->

    <application
        android:name=".ParentApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyGuardParent">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FamilyGuardParent"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- work.DashboardRefreshWorker (periodic, 15 min) needs no manifest entry: it is
             scheduled at runtime via WorkManager's WorkManagerInitializer, and its Hilt
             injection is wired through HiltWorkerFactory in ParentApp (implements
             androidx.work.Configuration.Provider), which WorkManager auto-detects — no
             `<provider>` override needed either. -->

    </application>

</manifest>
